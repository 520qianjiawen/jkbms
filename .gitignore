# Only publish source code, required runtime assets, tests, and shared build configuration.
*
!/.gitignore
!/README.md
!/THIRD_PARTY_NOTICES.md
!/Package.swift
!/PrivacyInfo.xcprivacy
!/LICENSES/
!/LICENSES/*.txt
!/Sources/
!/Sources/**/
!/Sources/**/*.swift
!/Sources/**/*.json
!/Tests/
!/Tests/**/
!/Tests/**/*.swift
!/Assets.xcassets/
!/Assets.xcassets/**/
!/Assets.xcassets/**/*.json
!/Assets.xcassets/**/*.png
!/tools/
!/tools/build_ios.sh
!/tools/generate_xcode_project.py
!/JKBMS.xcodeproj/
!/JKBMS.xcodeproj/project.pbxproj
!/JKBMS.xcodeproj/xcshareddata/
!/JKBMS.xcodeproj/xcshareddata/xcschemes/
!/JKBMS.xcodeproj/xcshareddata/xcschemes/JKBMS.xcscheme
